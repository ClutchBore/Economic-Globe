OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=your_chosen_model_slug_here
OPENROUTER_MAX_PRICE=0.01

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Used only by scripts/fetch_data.py for bond yields. Without it, every
# country's bond_yield_10y comes back null — not an error, not stale data.
FRED_API_KEY=your_key_here

# Upstash Redis, where country payloads live. Copy the .env snippet from the
# store's page in the Vercel dashboard. Only these two are read by the code;
# the rest of the snippet (KV_URL, REDIS_URL, read-only token) is unused.
KV_REST_API_URL=your_url_here
KV_REST_API_TOKEN=your_token_here
