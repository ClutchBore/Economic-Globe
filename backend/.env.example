IFM_API_KEY=your_key_here
IFM_MODEL=your_chosen_model_slug_here

# Upstash Redis REST credentials — create a Redis database at upstash.com and
# copy these from its REST API section. Country payloads live here (see
# services/kv_client.py and scripts/fetch_data.py); without these set, every
# request for real country data fails at the first request.
KV_REST_API_URL=your_upstash_rest_url_here
KV_REST_API_TOKEN=your_upstash_rest_token_here

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Used only by scripts/fetch_data.py for bond yields. Without it, every
# country's bond_yield_10y comes back null — not an error, not stale data.
FRED_API_KEY=your_key_here

# Comma-separated list of additional frontend origins allowed to call this API
# (localhost is always allowed). Set this to your deployed frontend's URL.
FRONTEND_ORIGINS=https://your-frontend.vercel.app
